{
  "gateway": {
    "bind": "lan",
    "port": 18789,
    "auth": {
      "mode": "token"
    },
    "controlUi": {
      "enabled": false
    }
  },
  "commands": {
    "bash": true,
    "bashForegroundMs": 30000
  },
  "browser": {
    "enabled": true,
    "headless": true
  },
  "session": {
    "scope": "per-sender",
    "maintenance": {
      "pruneAfter": "90d",
      "maxEntries": 2000
    }
  },
  "models": {
    "mode": "replace",
    "providers": {
      "harvis-proxy": {
        "api": "openai-completions",
        "baseUrl": "http://backend:8000/v1",
        "apiKey": "${OPENCLAW_GATEWAY_TOKEN}",
        "models": [
          { "id": "qwen3.5-32k:latest", "name": "Qwen 3.5 9.7B (Local Ollama)" }
        ]
      }
    }
  },
  "tools": {
    "elevated": {
      "enabled": true
    },
    "exec": {
      "host": "gateway",
      "security": "full",
      "ask": "off"
    }
  },
  "agents": {
    "defaults": {
      "elevatedDefault": "full",
      "verboseDefault": "full",
      "timeoutSeconds": 1200,
      "model": {
        "primary": "harvis-proxy/qwen3.5-32k:latest"
      },
      "subagents": {
        "model": "harvis-proxy/qwen3.5-32k:latest",
        "runTimeoutSeconds": 1200,
        "announceTimeoutMs": 30000,
        "maxSpawnDepth": 2,
        "maxChildrenPerAgent": 6,
        "maxConcurrent": 6
      },
      "heartbeat": {
        "every": "1h",
        "target": "none"
      }
    },
    "list": [
      {
        "id": "main",
        "default": true,
        "model": {
          "primary": "harvis-proxy/qwen3.5-32k:latest"
        }
      }
    ]
  },
  "skills": {
    "load": {
      "extraDirs": ["/skills"]
    }
  },
  "channels": {}
}
