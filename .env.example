# Harvis — root env template (what docker compose actually reads)
# Copy to `.env` or let `./install.sh` create one. Blank placeholders only —
# never commit real secrets. Most vars have compose defaults; this lists the
# ones that matter for a first install.

# ── Core (generated by ./install.sh if absent) ──────────────────────────────
# JWT_SECRET=          # required — install.sh generates; compose fails closed without it
# FERNET_KEY=          # encrypts stored GitHub OAuth tokens (url-safe base64, 32 bytes)
# OPENCLAW_GATEWAY_TOKEN=   # shared by backend / openclaw / harvis-mcp — generate-if-absent only
# HARVIS_SETUP_CODE=   # one-time first-admin signup gate (X-Setup-Code header)
# COMPOSE_FILE=        # set by install.sh (nvidia | cpu | amd profile + optional override)

# ── First-run / auth ────────────────────────────────────────────────────────
# HARVIS_OWUI_ENABLE_SIGNUP=false   # server-enforced; leave false after admin exists
# HARVIS_COOKIE_SECURE=false        # set true behind HTTPS so the auth cookie gets Secure

# ── Inference ───────────────────────────────────────────────────────────────
# Leave all four commented out for a normal install: Harvis then picks whichever
# models Ollama actually reports, so nothing depends on a specific `ollama pull`.
# Set one only to PIN a choice — and pin a tag you have really pulled, or the
# backend logs the mismatch and falls back to an installed model anyway.
# You do not need any of these to change the model day to day: the Build model
# picker and Discord `/model` switch it at runtime, no restart involved.
# OLLAMA_URL=http://ollama:11434
# HARVIS_DEFAULT_LOCAL_MODEL=       # operator-wide default when a user has no pick
# WORKSPACE_DETECTOR_OLLAMA_MODEL=  # small/fast NON-thinking model for build detection
# HARVIS_AUTO_MODEL_FALLBACK=       # used when a saved pick isn't installed anywhere
# DEEP_RESEARCH_MODEL=              # deep-research synthesis model

# ── Cloud providers (optional) ──────────────────────────────────────────────
# MOONSHOT_API_KEY=
# MOONSHOT_BASE_URL=https://api.moonshot.ai/v1
# NVIDIA_API_KEY=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# ── OpenClaw ────────────────────────────────────────────────────────────────
# OPENCLAW_URL=ws://openclaw:18789
# OPENCLAW_MODE=bundled
# OPENCLAW_BUNDLED_URL=ws://openclaw:18789
# OPENCLAW_GATEWAY_TOKEN_BUNDLED=

# ── Discord (optional) ──────────────────────────────────────────────────────
# DISCORD_BOT_TOKEN=
# DISCORD_ALLOWED_CHANNEL_IDS=
# DISCORD_WORKSPACE_ENABLED=
# HARVIS_CODE_CHANNEL_ID=
# HARVIS_CODE_GUILD_ID=

# ── Engines / sidecars (optional; most default off or have safe defaults) ───
# HARVIS_OWUI_EXTERNAL_ENGINES=true
# HARVIS_OWUI_HERMES_AGENT_ENGINE=false
# HARVIS_HERMES_API_SERVER_KEY=
# HARVIS_TERMINAL_ENABLED=
# HARVIS_SSH_ENABLED=

# ── Adaptive / CAD (optional, gated) ────────────────────────────────────────
# HARVIS_ADAPTIVE_CAD_ENABLED=
# HARVIS_ADAPTIVE_REPO_RUN_ENABLED=false
